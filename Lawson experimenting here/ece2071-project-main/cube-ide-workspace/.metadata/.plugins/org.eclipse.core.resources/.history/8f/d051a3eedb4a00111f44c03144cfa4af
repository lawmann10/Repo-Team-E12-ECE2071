void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART2) {

    	// reset the buffers and filtering

        sent_packets = 0;
        buffer_idx = 0;
        send_buf_1 = 0;
        send_buf_2 = 0;
        outlier_tripped = 0;

        sample_buffer[0] = 1985;
        sample_buffer[1] = 1985;
        running_sum = 1985 * 2;
        sample_index = 0;

    	if(receieved_metadata[0] == 0){ //received mode 0
            HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, 1);
    		mode = 0;
    		desired_recording_duration = receieved_metadata[1]; //save received recording duration
    	}

    	else if(receieved_metadata[0] == 1){
    		mode = 3; //put in mode 3 first, because we haven't checked ultrasonic sensor yet
    		desired_distance = receieved_metadata[1];
    	}

    	else if(receieved_metadata[0] == 2){
    	    mode = -1; //stop the recording
            HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, 0);
    	}


        HAL_UART_Receive_IT(huart, receieved_metadata, 2); // restart interrupt
    }
