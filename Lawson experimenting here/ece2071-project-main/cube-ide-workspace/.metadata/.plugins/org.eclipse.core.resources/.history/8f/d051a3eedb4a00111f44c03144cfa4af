// using volatile so the compiler won't cache the variables as they may change suddenly
volatile uint16_t t_rise = 0;
volatile uint16_t t_fall = 0;
volatile uint16_t pulse_width = 0;
volatile uint8_t data_ready = 0;
volatile int pulse_sent = 0;

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM1)
    {
        // rising edge (CH1) (echo sent)
        if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_1)
        {
            t_rise = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_1);
        }

        // falling edge (CH2) (echo recieved)
        else if (htim->Channel == HAL_TIM_ACTIVE_CHANNEL_2)
        {
            t_fall = HAL_TIM_ReadCapturedValue(htim, TIM_CHANNEL_2);

            pulse_width = (uint16_t)(t_fall - t_rise); // calculate the pulse width

            data_ready = 1; // flag the ultrasonic sensor code that the data is ready
        }
    }
}

uint32_t echo_time = 0;
uint32_t distance = 0;

uint32_t last_trigger_time = 0; // for our timeout

uint8_t debounce_count = 0;

uint8_t target_mode;

void ultrasonic_manager() {
	if (data_ready) { //if we've received a response

		float distance_cm = (pulse_width * 0.0343f) / 2.0f;

		data_ready = 0;
		pulse_sent = 0;

		__HAL_TIM_SET_COUNTER(&htim6, 0);

		if (desired_distance >= distance_cm) {
			target_mode = 1; //record
		}

		else {
			target_mode = 2; //don't record
		}

		if (target_mode == mode) {
			debounce_count = 0; // already in correct mode
		}

		else {
			debounce_count++;
		}

		if (debounce_count >= 3 || mode == 3) //if this is our first reading, don't worry about debouncing
				{
			mode = target_mode;
			HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, (mode == 1));

			debounce_count = 0;
		}

	}

	// timeout fail safe (if echo never comes back)
	if (pulse_sent == 1 && (HAL_GetTick() - last_trigger_time > 100)) { //if its been more than 100ms, reset.

		pulse_sent = 0;
		__HAL_TIM_SET_COUNTER(&htim6, 0);

		target_mode = 2; //obj must be out of range

		//update debounce and state appropriately

		if (target_mode == mode) {
			debounce_count = 0; // already in correct mode
		}

		else {
			debounce_count++;
		}

		if (debounce_count >= 3 || mode == 3) //if this is our first reading, don't worry about debouncing
				{
			mode = target_mode;
			HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, (mode == 1));

			debounce_count = 0;
		}

	}

	//send a pulse if hasn't sent a pulse and its waited 60ms
	if (pulse_sent == 0 && __HAL_TIM_GET_COUNTER(&htim6) > 60000) {

		HAL_GPIO_WritePin(Trigger_GPIO_Port, Trigger_Pin, 1);
		__HAL_TIM_SET_COUNTER(&htim16, 0);
		pulse_sent = 1;
		last_trigger_time = HAL_GetTick(); // record when we send the pulse

	}

	// end pulse if lasted more than 10us
	if (pulse_sent == 1 && __HAL_TIM_GET_COUNTER(&htim16) > 10) {

		HAL_GPIO_WritePin(Trigger_GPIO_Port, Trigger_Pin, 0);

	}

	return;
}

uint16_t sample_buffer[2] = {1985, 1985};
uint32_t running_sum = 1985 * 2;
uint16_t sample_index = 0;


uint16_t moving_average(uint16_t new_sample)
{
    // subtract old sample
    running_sum -= sample_buffer[sample_index];

    // store new sample
    sample_buffer[sample_index] = new_sample;

    // add new sample
    running_sum += new_sample;

    // move index
    sample_index = (sample_index + 1) % 2;

    // divide by actual valid sample count
    return (uint16_t)(running_sum / 2);
}


