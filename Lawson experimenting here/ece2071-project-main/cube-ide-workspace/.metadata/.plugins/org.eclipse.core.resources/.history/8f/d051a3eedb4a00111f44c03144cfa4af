  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_TIM16_Init();
  MX_TIM6_Init();
  MX_TIM1_Init();
  MX_SPI1_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  //int16_t received_value;



  HAL_TIM_Base_Start(&htim16);
  HAL_TIM_Base_Start(&htim6);

  HAL_TIM_IC_Start_IT(&htim1, TIM_CHANNEL_1);
  HAL_TIM_IC_Start_IT(&htim1, TIM_CHANNEL_2);


  HAL_SPI_Receive_DMA(&hspi1, (uint8_t*)&received_value, 1);

  HAL_UART_Receive_IT(&huart2, (uint8_t*)receieved_metadata, 2); //setup interrupt for uart2

  huart2.Instance->CR3 |= USART_CR3_DMAT;

  float recording_duration;


  while (1) {

		if (mode >= 1) {
			ultrasonic_manager();
		}

		if (mode >= 0) {

			if (send_buf_1) {
				send_buf_1 = 0;
				sent_packets++; //add to tally of packets sent

				HAL_UART_Transmit_DMA(&huart2, buffer_8bit_1, 2048);
			}

			else if (send_buf_2) {
				send_buf_2 = 0;
				sent_packets++;

				HAL_UART_Transmit_DMA(&huart2, buffer_8bit_2, 2048);
			}

			if (mode == 0) { //normal mode
				recording_duration = sent_packets * 0.0232199546; //calculate duration of current recording, it takes 23.2ms to send 1 packet

				if (recording_duration >= desired_recording_duration) { //check if recording has taken longer than requested duration. check mode 0 cause we have interrupts everywhere
					mode = -1; // stop recording
					HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, 0);
				}
			}
		}

		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}
	/* USER CODE END 3 */
}

